{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "app.py",
        "model.pkl",
        "vectorizer.pkl",
        "preprocess.py",
        "templates/**",
        "static/**",
        "public/**"
      ]
    }
  }
}
