{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__route__=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{app.py,preprocess.py,model.pkl,vectorizer.pkl,templates/**,static/**}"
    }
  }
}
